{
  "name": "alfred-dev-vscode",
  "displayName": "Alfred Dev for VS Code",
  "description": "Equipo de 12 agentes de ingeniería de software para VS Code con orquestación, quality gates y flujo GitHub.",
  "version": "0.7.0",
  "publisher": "SrScorpio",
  "repository": {
    "type": "git",
    "url": "https://github.com/SrScorpio/alfred-dev-vscode"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "alfred-dev.startFlow",
        "title": "Alfred Dev: Iniciar Flujo",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.checkUpdate",
        "title": "Alfred Dev: Comprobar actualización",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.refreshStatus",
        "title": "Alfred Dev: Refrescar Estado",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.openChat",
        "title": "Alfred Dev: Hablar con Alfred",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.openGithubIssue",
        "title": "Alfred Dev: Abrir issue de GitHub",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.progress",
        "title": "Alfred Dev: Ver progreso",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.pause",
        "title": "Alfred Dev: Pausar trabajo",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.retomar",
        "title": "Alfred Dev: Retomar trabajo",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.openSettings",
        "title": "Alfred Dev: Ajustes",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.selectModelProfile",
        "title": "Alfred Dev: Seleccionar perfil de modelo",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.openStyleGallery",
        "title": "Alfred Dev: Abrir galería visual",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.installSecretHook",
        "title": "Alfred Dev: Instalar Secret Guard pre-commit",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.memory.put",
        "title": "Alfred Dev: Guardar memoria local",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.memory.get",
        "title": "Alfred Dev: Consultar memoria local",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.memory.search",
        "title": "Alfred Dev: Buscar memoria local",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.memory.clear",
        "title": "Alfred Dev: Borrar memoria local",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.memory.explore",
        "title": "Alfred Dev: Explorar memoria local",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.ralph.openKanban",
        "title": "Alfred Dev: Abrir Kanban Ralph",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.ralph.runTask",
        "title": "Alfred Dev: Ejecutar tarea Ralph",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.ralph.startRunner",
        "title": "Alfred Dev: Iniciar runner Ralph",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.ralph.stopRunner",
        "title": "Alfred Dev: Detener runner Ralph",
        "category": "Alfred Dev"
      },
      {
        "command": "alfred-dev.ralph.syncIssue",
        "title": "Alfred Dev: Sincronizar issue con Ralph",
        "category": "Alfred Dev"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "alfred-dev.ralph.openKanban",
          "when": "alfred-dev.ralph.openKanban"
        },
        {
          "command": "alfred-dev.ralph.runTask",
          "when": "alfred-dev.ralph.runTask"
        },
        {
          "command": "alfred-dev.ralph.startRunner",
          "when": "alfred-dev.ralph.startRunner"
        },
        {
          "command": "alfred-dev.ralph.stopRunner",
          "when": "alfred-dev.ralph.stopRunner"
        },
        {
          "command": "alfred-dev.ralph.syncIssue",
          "when": "alfred-dev.ralph.syncIssue"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "alfred-dev.memory",
        "label": "Alfred Dev Memory"
      }
    ],
    "configuration": {
      "title": "Alfred Dev",
      "properties": {
        "alfred-dev.modelProfile": {
          "type": "string",
          "enum": ["luna", "terra", "sol"],
          "enumDescriptions": [
            "Trabajo frecuente y de protocolo",
            "Razonamiento y auditoría",
            "Solo para lo muy complicado"
          ],
          "default": "luna",
          "description": "Perfil visual de coste preferido para los agentes de Alfred Dev."
        },
        "alfred-dev.memory.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Activa la memoria local de Alfred Dev. Usa MCP cuando VS Code lo soporta y comandos como degradación compatible."
        },
        "alfred-dev.secretGuard.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Muestra avisos no bloqueantes al guardar posibles secretos."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "alfred-dev-container",
          "title": "Alfred Dev",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "alfred-dev-container": [
        {
          "id": "alfred-dev-status",
          "name": "Estado del Proyecto (status.md)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "package": "vsce package",
    "pretest": "npm run compile",
    "test": "node --test tests/*.test.js",
    "verify-package": "node tests/package-contract.test.js",
    "sbom": "cyclonedx-npm --package-lock-only --output-reproducible --spec-version 1.5 --output-format JSON --output-file docs/project/sbom.cdx.json --validate",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@vscode/vsce": "3.9.2",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
